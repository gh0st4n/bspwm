#!/usr/bin/env bash

# Small delay to allow session initialization
sleep 0.5

### DBUS
# [DIHAPUS] Biarkan LightDM atau startx yang mengatur D-Bus. 
# Menggunakan dbus-launch di sini akan membuat bus di /tmp yang bermasalah.

### CURSOR
xsetroot -cursor_name left_ptr &

### HOTKEY
pgrep -x sxhkd >/dev/null || sxhkd &

### WALLPAPER
pgrep -x feh >/dev/null || \
feh --no-fehbg --bg-fill "$HOME/.config/bspwm/wallpaper/wallpaper4.png" &

### NOTIFICATION
pgrep -x dunst >/dev/null || dunst &

### POLKIT
pgrep -x polkit-gnome-authentication-agent-1 >/dev/null || \
/usr/libexec/polkit-gnome-authentication-agent-1 &

### AUDIO (DIPERBAIKI)
# Bersihkan instance lama (mencegah double spawn saat bspwm restart)
pkill -x pipewire 2>/dev/null
pkill -x pipewire-pulse 2>/dev/null
pkill -x wireplumber 2>/dev/null
sleep 0.3

# Jalankan PipeWire dulu
pipewire &
# Tunggu socket PipeWire muncul (maksimal 3 detik)
for i in {1..30}; do
    [ -S "$XDG_RUNTIME_DIR/pipewire-0" ] && break
    sleep 0.1
done

# Baru jalankan WirePlumber dan PipeWire-Pulse
wireplumber &
pipewire-pulse &

### COMPOSITOR
pgrep -x picom >/dev/null || ~/.config/picom/auto.sh &

### BAR
pgrep -x polybar >/dev/null || ~/.config/polybar/launch.sh &

### MONITOR HOTPLUG
pgrep -f monitor >/dev/null || ~/.config/sxhkd/scripts/monitor &
